<style>
/* App Affair's — mobile, charte affairs.fr (rouge logo, jaune cash, gris titres), thème clair unique */
:root{
  --red:#e30613; --red-d:#b8050f; --yellow:#fdc300; --ink:#2e2e2e; --title:#5f5e5e; --panel:#f5f5f5;
  --line:#e0e0e0; --white:#fff; --black:#151515; --muted:#6b6b6b;
  --good:#1e9e4a; --good-bg:#e6f5eb; --warn:#b77400; --warn-bg:#fff4d6; --bad:#e30613; --bad-bg:#fde6e7;
  --font:"Open Sans",Arial,Helvetica,sans-serif; --tab-h:64px; color-scheme:light;
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;background:var(--panel);color:var(--ink);font:15.5px/1.5 var(--font)}
button,input,select{font:inherit;color:inherit}
h1,h2,h3,h4{margin:0;text-wrap:balance}
:focus-visible{outline:3px solid var(--yellow);outline-offset:2px}
.app{max-width:560px;margin:0 auto;min-height:100vh;background:var(--white);position:relative;padding-bottom:calc(var(--tab-h) + env(safe-area-inset-bottom,0px) + 10px)}
.banner{background:var(--yellow);color:var(--black);font-size:12.5px;font-weight:700;text-align:center;padding:6px 12px}
.banner.red{background:var(--red);color:#fff}

/* En-tête */
.top{position:sticky;top:0;z-index:20;background:var(--white);display:flex;align-items:center;justify-content:space-between;gap:10px;padding:calc(env(safe-area-inset-top,0px) + 8px) 16px 8px;box-shadow:0 2px 6px -3px rgba(0,0,0,.25)}
.top img{height:46px;width:auto;display:block}
.top .call{display:inline-flex;align-items:center;gap:6px;background:var(--yellow);color:var(--black);font-weight:700;font-size:13px;padding:7px 10px;text-decoration:none;text-transform:uppercase}
.top .back{background:none;border:0;font-weight:700;color:var(--red);padding:8px 0;cursor:pointer;font-size:15px}

/* Barre d'onglets */
.tabs{position:fixed;left:0;right:0;bottom:0;z-index:30;background:var(--black);padding-bottom:env(safe-area-inset-bottom,0px)}
.tabs .in{max-width:560px;margin:0 auto;display:grid;grid-template-columns:repeat(5,1fr);height:var(--tab-h)}
.tabs button{background:none;border:0;color:#bdbdbd;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;font-size:11px;font-weight:600;cursor:pointer;text-transform:uppercase;letter-spacing:.02em}
.tabs svg{width:24px;height:24px}
.tabs button[aria-current="page"]{color:var(--yellow)}
.tabs button.est{color:var(--black)}
.tabs button.est .bub{background:var(--yellow);border-radius:50%;width:44px;height:44px;display:grid;place-items:center;margin-top:-18px;box-shadow:0 0 0 4px var(--black)}
.tabs button.est span.l{color:#bdbdbd}
.tabs button.est[aria-current="page"] span.l{color:var(--yellow)}

.scr{padding:0 16px 24px}
.scr[hidden]{display:none}
.h1{font-size:26px;font-weight:400;text-align:center;line-height:1.2;padding-top:22px}
.h1::after{content:"";display:block;width:110px;height:6px;background:var(--yellow);margin:12px auto 0}
.h2{font-size:18px;font-weight:700;color:var(--title);text-transform:uppercase;margin:24px 0 12px}
.lead{text-align:center;margin:14px 0 18px}
.small{font-size:12.5px;color:var(--muted)}

/* Boutons */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;border:0;border-radius:0;font-weight:700;text-transform:uppercase;text-decoration:none;cursor:pointer;padding:12px 18px;font-size:15px;min-height:48px}
.btn-cash{background:var(--yellow);color:var(--black)}
.btn-red{background:var(--red);color:#fff}
.btn-ghost{background:#fff;border:1px solid #bdbdbd;color:var(--ink)}
.btn-full{width:100%}
.btn[disabled]{opacity:.4;cursor:not-allowed}

/* Accueil */
.hero{background:var(--red);color:#fff;margin:0 -16px;padding:26px 20px 24px;text-align:center;border-bottom:8px solid var(--yellow)}
.hero small{display:block;font-size:13px;text-transform:uppercase;font-weight:700;letter-spacing:.05em;opacity:.9}
.hero h1{font-size:28px;font-weight:800;text-transform:uppercase;line-height:1.1;margin:8px 0 6px}
.hero p{margin:0 0 18px}
.quick{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:18px}
.qk{background:var(--panel);border:0;text-align:left;padding:14px;display:flex;flex-direction:column;gap:6px;cursor:pointer;min-height:96px;text-decoration:none;color:var(--ink)}
.qk b{font-size:15px;text-transform:uppercase}
.qk span{font-size:13px;color:var(--muted)}
.qk i{font-style:normal;font-size:24px}
.qk.or{background:var(--yellow)}
.qk.or span{color:var(--black)}
.gar{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.gar div{display:flex;gap:10px;align-items:center;background:var(--panel);padding:12px;font-weight:600;font-size:13.5px}
.gar i{font-style:normal;font-size:22px}
.steps3{display:grid;gap:12px}
.st3{display:flex;gap:14px;align-items:flex-start}
.st3 .n{width:40px;height:40px;border-radius:50%;background:var(--red);color:#fff;font-weight:700;font-size:19px;display:grid;place-items:center;flex:none}
.about{background:var(--panel);padding:16px;font-size:14.5px;margin-top:14px}

/* Acheter */
.note{display:flex;gap:10px;background:var(--warn-bg);padding:12px 14px;font-size:13.5px;margin:14px 0}
.cat-acc{border-top:1px solid var(--line)}
.cat-acc details{border-bottom:1px solid var(--line)}
.cat-acc summary{list-style:none;display:flex;align-items:center;gap:12px;padding:15px 4px;font-weight:700;text-transform:uppercase;cursor:pointer;font-size:15px}
.cat-acc summary::-webkit-details-marker{display:none}
.cat-acc summary .ic{font-size:22px;width:30px;text-align:center}
.cat-acc summary::after{content:"+";margin-left:auto;font-size:22px;color:var(--red);font-weight:400}
.cat-acc details[open] summary::after{content:"–"}
.sub{display:grid;gap:6px;padding:0 0 14px 46px}
.sub a,.sub button{background:none;border:0;text-align:left;padding:8px 0;color:var(--ink);text-decoration:none;cursor:pointer;font-size:14.5px;display:flex;justify-content:space-between}
.sub a::after,.sub button::after{content:"↗";color:var(--muted)}
.sub .all{font-weight:700;color:var(--red)}

/* Magasins */
.depts{display:flex;gap:6px;overflow-x:auto;margin:12px -16px 14px;padding:0 16px}
.depts button{border:1px solid #bdbdbd;background:#fff;padding:7px 13px;cursor:pointer;font-weight:600;font-size:13.5px;white-space:nowrap}
.depts button[aria-pressed="true"]{background:var(--black);color:#fff;border-color:var(--black)}
.store{border:1px solid var(--line);padding:14px;display:grid;gap:4px;margin-bottom:12px;background:#fff;width:100%;text-align:left;font-size:14px}
.store .dep{font-size:11.5px;font-weight:700;color:var(--title);text-transform:uppercase}
.store h3{font-size:17px;font-weight:700;text-transform:uppercase}
.store .hrs{color:var(--muted);font-size:13px}
.store .acts{display:grid;grid-template-columns:1fr 1fr 1fr;gap:6px;margin-top:8px}
.store .acts .btn{min-height:40px;padding:8px;font-size:12.5px}
.soc{display:flex;flex-wrap:wrap;gap:6px;margin-top:6px}
.soc button{background:var(--panel);border:0;padding:7px 10px;font-size:12.5px;font-weight:600;cursor:pointer}
button.store{cursor:pointer}
button.store[aria-pressed="true"]{border:2px solid var(--red);box-shadow:inset 0 -5px 0 var(--yellow)}

/* Infos */
.list{border-top:1px solid var(--line)}
.list a,.list button{display:flex;align-items:center;gap:12px;width:100%;background:none;border:0;border-bottom:1px solid var(--line);padding:15px 4px;text-align:left;color:var(--ink);text-decoration:none;cursor:pointer;font-size:15px}
.list a::after,.list button::after{content:"›";margin-left:auto;font-size:22px;color:var(--muted)}
.list i{font-style:normal;font-size:20px;width:28px;text-align:center}
.help{background:var(--black);color:#fff;padding:18px;display:flex;align-items:center;gap:14px;margin-top:16px}
.help b{display:block;font-size:22px;user-select:all}
.doc h3{font-size:15px;font-weight:700;margin:18px 0 6px;color:var(--title);text-transform:uppercase}
.doc p,.doc li{font-size:14px}

/* Estimation */
.pbar{display:flex;gap:4px;margin:14px 0 18px}
.pbar i{flex:1;height:6px;background:#dcdcdc}
.pbar i.on{background:var(--red)}
.pbar i.cur{background:var(--yellow)}
.ev h2{font-size:20px;font-weight:700;color:var(--title);text-transform:uppercase;text-align:center}
.ev .sub2{text-align:center;margin:6px 0 18px;font-size:14.5px}
.cats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.cat{display:flex;flex-direction:column;align-items:center;gap:6px;padding:14px 4px;border:1px solid var(--line);background:#fff;cursor:pointer;font-weight:600;font-size:12px;text-transform:uppercase;text-align:center;min-height:92px;justify-content:center}
.cat .ico{font-size:28px;line-height:1}
.cat[aria-pressed="true"]{border-color:var(--red);box-shadow:inset 0 -4px 0 var(--yellow)}
.chosen{text-align:center;font-size:14px;margin-bottom:10px}
.chosen button{background:none;border:0;color:var(--red);font-weight:700;text-decoration:underline;cursor:pointer}
.tip{display:flex;gap:10px;background:var(--panel);border-left:5px solid var(--yellow);padding:10px 12px;font-size:13.5px;margin-bottom:14px}
.slots{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.slot{position:relative;aspect-ratio:1/1;border:2px dashed #c7c7c7;background:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;text-align:center;cursor:pointer;overflow:hidden;padding:4px;font-size:11px;color:var(--muted)}
.slot strong{color:var(--ink);font-size:11.5px;line-height:1.2}
.slot .plus{font-size:24px;color:var(--red);line-height:1}
.slot.filled{border:2px solid var(--red);padding:0}
.slot img{width:100%;height:100%;object-fit:cover}
.slot .lbl{position:absolute;left:0;right:0;bottom:0;background:rgba(21,21,21,.78);color:#fff;font-size:10.5px;padding:2px 5px;text-align:left}
.slot .rm{position:absolute;top:4px;right:4px;width:26px;height:26px;border-radius:50%;border:0;background:var(--red);color:#fff;font-size:15px;cursor:pointer}
.two{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:12px 0 4px}
.counter{font-size:13px;color:var(--muted)}
.field{margin-top:14px}
.field label,.field .lab{display:block;font-weight:700;font-size:14px;margin-bottom:6px}
.field input,.field select{width:100%;padding:11px 12px;border:1px solid #bdbdbd;border-radius:0;background:#fff;font-size:16px}
.checks{display:flex;flex-wrap:wrap;gap:6px}
.chk{display:inline-flex;align-items:center;gap:6px;border:1px solid #bdbdbd;padding:8px 11px;font-size:13.5px;cursor:pointer}
.chk:has(input:checked){border-color:var(--red)}
.chk input{accent-color:var(--red)}
.sticky-cta{position:sticky;bottom:calc(var(--tab-h) + env(safe-area-inset-bottom,0px) + 6px);margin-top:18px;z-index:5}
.linkish{background:none;border:0;text-decoration:underline;color:var(--ink);cursor:pointer;padding:10px 0;font-size:14px}
.scan-img{position:relative;width:62%;margin:10px auto 14px;aspect-ratio:1/1;overflow:hidden;border:1px solid var(--line)}
.scan-img img{width:100%;height:100%;object-fit:cover}
.scan-img::after{content:"";position:absolute;left:0;right:0;height:36%;top:-36%;background:linear-gradient(180deg,transparent,rgba(253,195,0,.55),transparent);animation:scan 1.6s linear infinite}
@keyframes scan{to{top:100%}}
.phases{list-style:none;margin:0;padding:0;display:grid;gap:10px}
.phases li{display:flex;align-items:center;gap:10px;color:var(--muted)}
.phases .dot{width:26px;height:26px;border-radius:50%;border:3px solid #d0d0d0;display:grid;place-items:center;flex:none;font-size:13px;font-weight:700}
.phases li.run{color:var(--ink);font-weight:600}
.phases li.run .dot{border-color:var(--red);border-top-color:transparent;animation:spin .8s linear infinite}
.phases li.ok{color:var(--ink)}
.phases li.ok .dot{background:var(--red);border-color:var(--red);color:#fff}
@keyframes spin{to{transform:rotate(360deg)}}
.bar{height:7px;background:#e0e0e0;margin-top:16px}
.bar i{display:block;height:100%;width:0;background:var(--yellow);transition:width .5s}
.note2{font-size:13px;color:var(--muted);margin-top:8px;min-height:1.5em}
.prod{display:flex;gap:12px;align-items:flex-start;background:var(--panel);padding:12px}
.prod img{width:80px;height:80px;object-fit:cover;flex:none;background:#fff}
.prod>div{min-width:0}
.prod h3{font-size:19px;font-weight:700}
.tag{display:inline-block;font-size:11px;font-weight:700;text-transform:uppercase;padding:2px 8px;background:#fff;color:var(--title)}
.spec{color:var(--muted);font-weight:600;font-size:13.5px}
.meta{display:flex;flex-wrap:wrap;gap:6px;margin-top:6px}
.pill{display:inline-flex;align-items:center;gap:5px;font-size:12px;font-weight:600;padding:2px 9px;border-radius:999px}
.pill::before{content:"";width:7px;height:7px;border-radius:50%;background:currentColor}
.pill.good{background:var(--good-bg);color:var(--good)}.pill.warn{background:var(--warn-bg);color:var(--warn)}.pill.bad{background:var(--bad-bg);color:var(--bad)}
.block{background:var(--panel);padding:12px;margin-top:10px}
.block h4{font-size:13px;text-transform:uppercase;color:var(--title);margin-bottom:8px}
.obs{list-style:none;margin:0;padding:0;display:grid;gap:6px;font-size:14.5px}
.obs li{display:flex;gap:8px}
.obs li::before{content:"✓";color:var(--good);font-weight:800}
.obs li.def::before{content:"!";color:var(--warn)}
.buy{background:var(--red);color:#fff;padding:18px;border-bottom:7px solid var(--yellow);margin-top:14px}
.buy small{display:block;font-size:12.5px;text-transform:uppercase;font-weight:700}
.buy strong{display:block;font-size:40px;font-weight:800;line-height:1.1;margin-top:4px;font-variant-numeric:tabular-nums}
.buy .cash{display:inline-block;margin-top:8px;background:var(--yellow);color:var(--black);font-weight:700;font-size:12px;text-transform:uppercase;padding:3px 9px}
.buy p{margin:10px 0 0;font-size:13px}
.disc{font-size:12.5px;color:var(--muted);border-left:4px solid var(--yellow);padding:2px 0 2px 10px;margin-top:12px}
.recap{display:flex;justify-content:space-between;gap:10px;background:var(--panel);border-left:5px solid var(--red);padding:10px 12px;margin-bottom:12px;font-size:14px}
.recap .rp{font-weight:800;color:var(--red);font-size:17px;white-space:nowrap}
.err{color:var(--red);font-weight:600;font-size:13.5px;margin-top:8px}
.ticket{border-top:7px solid var(--red);background:var(--panel)}
.ticket .th{text-align:center;padding:14px;border-bottom:2px dashed var(--line)}
.ticket .ref{font-size:26px;font-weight:800;letter-spacing:.05em;user-select:all}
.ticket dl{margin:0;padding:12px 14px;display:grid;grid-template-columns:auto 1fr;gap:6px 12px;font-size:14px}
.ticket dt{color:var(--muted)}.ticket dd{margin:0;font-weight:600;min-width:0}
.ticket .amt{background:var(--red);color:#fff;padding:12px 14px;display:flex;justify-content:space-between;align-items:center;border-bottom:5px solid var(--yellow)}
.ticket .amt strong{font-size:24px;font-weight:800}
.bring{background:var(--panel);padding:12px 14px;margin-top:12px}
.bring h4{font-size:13px;text-transform:uppercase;color:var(--title);margin-bottom:6px}
.bring ul{margin:0;padding-left:18px;font-size:14px;display:grid;gap:4px}
.refuse{text-align:center;padding-top:20px}
.refuse .big{font-size:48px}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>

<div class="app" id="app">
  <div class="banner red" id="ai-banner" hidden>Le service d'estimation n'est pas configuré dans cette version.</div>
  <header class="top">
    <button class="back" id="back" hidden>‹ Retour</button>
    <img id="top-logo" src="LOGO_SRC" alt="Affair's — Achetez malin, vendez cash" width="94" height="46">
    <a class="call" href="tel:0476494203" data-ext="tel"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg>Appeler</a>
  </header>

  <!-- ACCUEIL -->
  <section class="scr" data-screen="accueil">
    <div class="hero">
      <small>Achetez malin · Vendez cash</small>
      <h1>Nous achetons cash vos objets</h1>
      <p>Estimez votre article en quelques photos, puis venez en magasin : paiement immédiat.</p>
      <button class="btn btn-cash btn-full" data-go="estimer">📸 Estimer mon article</button>
    </div>
    <div class="quick">
      <button class="qk" data-go="acheter"><i>🛒</i><b>Acheter</b><span>Neuf, occasion et reconditionné garantis 2 ans</span></button>
      <button class="qk" data-go="magasins"><i>📍</i><b>Nos magasins</b><span>6 magasins en Auvergne-Rhône-Alpes</span></button>
      <button class="qk or" data-doc="or"><i>🪙</i><b>Vendre mon or</b><span>Expertise gratuite et confidentielle</span></button>
      <button class="qk" data-doc="rachat"><i>✅</i><b>Ce que nous rachetons</b><span>La liste des produits acceptés</span></button>
    </div>
    <h2 class="h2">Vendre, comment ça marche ?</h2>
    <div class="steps3">
      <div class="st3"><span class="n">1</span><div><b>Estimez en ligne</b><br><span class="small">Prenez quelques photos : notre IA identifie votre article et vous donne une estimation de reprise.</span></div></div>
      <div class="st3"><span class="n">2</span><div><b>Choisissez votre magasin</b><br><span class="small">Vous recevez un numéro d'estimation valable 7 jours.</span></div></div>
      <div class="st3"><span class="n">3</span><div><b>Payé cash</b><br><span class="small">Nos acheteurs contrôlent l'article et vous paient immédiatement en espèces (par chèque pour les gros montants).</span></div></div>
    </div>
    <h2 class="h2">Nos garanties</h2>
    <div class="gar">
      <div><i>🛡️</i>Garantie 2 ans (1)</div>
      <div><i>🏬</i>Retrait gratuit en magasin</div>
      <div><i>🚚</i>Livraison en 48h</div>
      <div><i>↩️</i>Satisfait ou remboursé 15 jours</div>
    </div>
    <div class="about" data-doc="apropos" style="cursor:pointer"><b>AFFAIR'S</b>, magasins spécialisés dans la vente et l'achat <b>CASH</b> aux particuliers depuis plus de 25 ans. Produits neufs, d'occasion et reconditionnés, rigoureusement testés par nos professionnels. <b style="color:var(--red)">En savoir plus ›</b></div>
    <p class="small">(1) Garantie légale de conformité, voir les conditions générales de vente.</p>
  </section>

  <!-- ESTIMER -->
  <section class="scr ev" data-screen="estimer" hidden>
    <div class="pbar" id="pbar"><i></i><i></i><i></i><i></i><i></i></div>

    <div id="v-cat">
      <h2>Que souhaitez-vous vendre ?</h2>
      <p class="sub2">Choisissez la catégorie la plus proche.</p>
      <div class="cats" id="cats"></div>
    </div>

    <div id="v-photos" hidden>
      <div class="chosen" id="chosen"></div>
      <h2>Vos photos</h2>
      <p class="sub2">À la lumière du jour, sur un fond simple.</p>
      <div class="tip"><span>💡</span><span><b>Plus de photos = estimation plus précise.</b> L'étiquette ou la référence aide beaucoup.</span></div>
      <div class="slots" id="slots"></div>
      <div class="two">
        <label class="btn btn-red" for="in-camera">📷 Photo</label>
        <label class="btn btn-ghost" for="in-multi">🖼️ Galerie</label>
      </div>
      <input type="file" id="in-camera" accept="image/*" capture="environment" hidden>
      <input type="file" id="in-multi" accept="image/*" multiple hidden>
      <input type="file" id="in-slot" accept="image/*" hidden>
      <div class="counter" id="counter"></div>
      <div class="field"><label for="f-model">Modèle, si vous le connaissez</label><input type="text" id="f-model" placeholder="Ex. iPhone 15 128 Go, Xbox Series X…" autocomplete="off"></div>
      <div class="field"><label for="f-etat">État de votre article, selon vous</label>
        <select id="f-etat"><option value="">Je ne sais pas / laisser l'IA juger</option><option value="tres_bon">Très bon état (aucune trace)</option><option value="bon">Bon état (légères traces)</option><option value="correct">État correct (rayures visibles)</option><option value="abime">Abîmé (casse, panne)</option></select></div>
      <div class="field"><span class="lab">Ce que vous apportez</span><div class="checks">
        <label class="chk"><input type="checkbox" id="acc-box" value="boîte"> Boîte</label>
        <label class="chk"><input type="checkbox" id="acc-charger" value="chargeur / câbles"> Chargeur / câbles</label>
        <label class="chk"><input type="checkbox" id="acc-invoice" value="facture"> Facture</label></div></div>
      <div class="sticky-cta"><button class="btn btn-cash btn-full" id="analyse" disabled>Lancer l'estimation</button></div>
    </div>

    <div id="v-scan" hidden>
      <h2 id="scan-title">Notre IA examine votre article</h2>
      <p class="sub2" id="scan-sub"></p>
      <div class="scan-img"><img id="scan-main" alt=""></div>
      <ul class="phases" id="phases"></ul>
      <div class="bar"><i id="bar"></i></div>
      <p class="note2" id="scan-note"></p>
    </div>

    <div id="v-confirm" hidden></div>
    <div id="v-result" hidden></div>
    <div id="v-store" hidden></div>
    <div id="v-done" hidden></div>

    <div id="v-old" hidden><div class="refuse"><div class="big">❌</div><h2 style="color:var(--red)">Article trop ancien</h2><p id="old-model"></p>
      <p><b>Merci pour votre demande. Nous ne sommes généralement pas intéressés par les téléphones de 2017 ou antérieurs.</b></p>
      <button class="btn btn-cash btn-full" id="old-back">Retour à l'estimation</button></div></div>

    <div id="v-error" hidden><div class="refuse"><div class="big">🔍</div><h2 id="err-title"></h2><p id="err-text"></p>
      <div style="display:grid;gap:8px"><button class="btn btn-cash" id="err-retry">Réessayer</button><button class="btn btn-ghost" id="err-photos">Modifier mes photos</button><button class="btn btn-ghost" id="err-restart">Recommencer</button></div></div></div>
  </section>

  <!-- ACHETER -->
  <section class="scr" data-screen="acheter" hidden>
    <h1 class="h1">Acheter chez Affair's</h1>
    <p class="lead">Neuf, occasion et reconditionné, <b>garantis 2 ans</b>.</p>
    <div class="note"><span>ℹ️</span><span>Le catalogue et les commandes se font sur notre site affairs.fr : chaque rubrique s'ouvre directement sur la bonne page.</span></div>
    <div class="cat-acc" id="catalog"></div>
    <button class="btn btn-red btn-full" style="margin-top:18px" data-url="https://www.affairs.fr/catalogue.html">Voir tout le catalogue</button>
  </section>

